  "events": [
   {
    "t": 0.6,
    "do": "lesson",
    "title": "第一课　行军",
    "text": "此为讲武校场。先学行军。\n电脑：左键点选一阵，右键点地面，军阵即开往该处。\n手机：轻点军阵选中，再轻点地面。\n视野：方向键或 WASD 移动，滚轮缩放（手机单指拖动、双指缩放），点右下小地图可跳转。\n令“前军”（戟兵）开到东面“将台”旗下。",
    "ok": "领命"
   }
  ],
  "triggers": [
   {
    "when": {
